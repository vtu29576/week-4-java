
import java.util.Stack;
import java.util.Scanner;

public class BrowserHistory {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        Stack<String> history = new Stack<>();

        while (true) {
            System.out.println("\n1. Visit a page");
            System.out.println("2. Back");
            System.out.println("3. Show current page");
            System.out.println("4. Exit");
            System.out.print("Enter your choice: ");

            int choice = sc.nextInt();
            sc.nextLine();

            switch (choice) {
                case 1:
                    System.out.print("Enter website URL: ");
                    String url = sc.nextLine();
                    history.push(url);
                    System.out.println("Visited: " + url);
                    break;

                case 2:
                    if (!history.isEmpty()) {
                        System.out.println("Going back from: "
                                + history.pop());
                        if (!history.isEmpty()) {
                            System.out.println("Current page: "
                                    + history.peek());
                        } else {
                            System.out.println("No previous page.");
                        }
                    } else {
                        System.out.println("Browser history is empty.");
                    }
                    break;

                case 3:
                    if (!history.isEmpty()) {
                        System.out.println("Current page: "
                                + history.peek());
                    } else {
                        System.out.println("No page visited yet.");
                    }
                    break;

                case 4:
                    System.out.println("Exiting browser history.");
                    sc.close();
                    return;

                default:
                    System.out.println("Invalid choice!");
            }
        }
    }
}
